  {
   "embedHandler": "delta",
   "description": "Tests requiring the 'delta' custom embed handler to be registered",
   "tests": [
    {
     "name": "diffs a nested delta embed structurally",
     "a": [
      {
       "insert": {
        "delta": [
         {
          "insert": "a"
         }
        ]
       }
      }
     ],
     "b": [
      {
       "insert": {
        "delta": [
         {
          "insert": "ab"
         }
        ]
       }
      }
     ],
     "expected": [
      {
       "retain": {
        "delta": [
         {
          "retain": 1
         },
         {
          "insert": "b"
         }
        ]
       }
      }
     ]
    },
    {
     "name": "diffs a nested delta embed structurally with outer attribute changes",
     "a": [
      {
       "insert": {
        "delta": [
         {
          "insert": "a"
         }
        ]
       }
      }
     ],
     "b": [
      {
       "insert": {
        "delta": [
         {
          "insert": "ab"
         }
        ]
       },
       "attributes": {
        "bold": true
       }
      }
     ],
     "expected": [
      {
       "retain": {
        "delta": [
         {
          "retain": 1
         },
         {
          "insert": "b"
         }
        ]
       },
       "attributes": {
        "bold": true
       }
      }
     ]
    }
   ]
  },
